{
  "cleanupPeriodDays": 20,
  "wslInheritsWindowsSettings": true,
  "env": {
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "false",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "true",
    "CLAUDE_CODE_IDE_SKIP_VALID_CHECK": "true",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "false",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "true",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "DISABLE_ERROR_REPORTING": "true",
    "DISABLE_TELEMETRY": "true",
    "DISABLE_AUTOUPDATER": "true",
    "DISABLE_FEEDBACK_COMMAND": "true",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Skill(*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(agy:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/.pem)",
      "Read(**/*.key)",
      "Bash(cat **/.env*)",
      "Bash(head **/.env*)",
      "Bash(tail **/.env*)",
      "Bash(grep * **/.env*)",
      "Bash(less **/.env*)",
      "Bash(more **/.env*)",
      "Bash(open **/.env*)",
      "Bash(cat **/secrets*)",
      "Bash(cat **/*.key)",
      "Bash(cat **/*.pem)",
      "Bash(curl *)",
      "Bash(sudo:*)",
      "Bash(cat **/google-services.json)",
      "Read(**/.env*)",
      "Edit(**/.env*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "enableAllProjectMcpServers": false,
  "skillOverrides": {
    "software-architecture": "off",
    "aws-lambda-typescript": "off",
    "tradeoff": "off",
    "information-design": "off",
    "deploy-commander": "off",
    "subagent-drive-development": "off",
    "technical-writer": "off",
    "openapi-conventions": "off",
    "agent-design-review": "off",
    "evidence-based": "off",
    "full-scan": "off",
    "db-architect": "off",
    "coding": "off",
    "ax": "off"
  },
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/notify.sh 'Claude Code' '❗ ユーザーの指示が必要です'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/notify.sh 'Claude Code' '✅ タスクが完了しました'"
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/remember-nudge.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/inject-lessons.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/exploration-guard.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/feedback-guard.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "example-skills@anthropic-agent-skills": false,
    "typescript-lsp@claude-plugins-official": true,
    "context7@context7-marketplace": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "language": "ネットスラングを多用するうざい2ちゃんねらー。またクスッとさせるような笑いのセンスも持ち合わせているが、ユーザからの質問には真摯にスペシャリストの観点で丁寧に答える",
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "advisorModel": "opus",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "theme": "auto",
  "switchModelsOnFlag": true,
  "autoScrollEnabled": true,
  "wheelScrollAccelerationEnabled": true,
  "fileCheckpointingEnabled": true,
  "todoFeatureEnabled": true
}
