alias lg='lazygit'
alias vim='nvim'
alias vi='nvim'
{%- if os() == "linux" %}
# Windows のホーム。シェルを開くたびに cmd.exe を呼ぶので、1回だけ取って下の alias で使い回す
_win_home="$(wslpath "$(/mnt/c/WINDOWS/system32/cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r')")"
# windows system command
alias wsl='/mnt/c/Windows/System32/wsl.exe'
alias winget="$_win_home/AppData/Local/Microsoft/WindowsApps/winget.exe"
alias wslc='/mnt/c/Program\ Files/WSL/wslc.exe'
# Notion
alias notion="nohup $_win_home/AppData/Local/Programs/Notion/Notion.exe > /dev/null 2>&1 &"
alias notkill='/mnt/c/Windows/System32/taskkill.exe /F /IM Notion.exe'
# Claude Desktop
alias dt-claude="nohup $_win_home/AppData/Local/Application\ Data/AnthropicClaude/claude.exe > /dev/null 2>&1 &"
alias dt-claudekill='/mnt/c/Windows/System32/taskkill.exe /F /IM claude.exe'
# Windows Claude
alias win-claude="$_win_home/.local/bin/claude.exe"
unset _win_home
{%- endif %}

# Modern CLI Tools (Homebrew)
alias cat='bat'
alias ls='eza --group-directories-first --time-style=long-iso --git'
{%- if os() == "macos" %}
alias ll='eza --icons -l --group-directories-first --time-style=long-iso --git'
alias la='eza -a --group-directories-first'
alias tree='eza --icons -T --no-user'
{%- else %}
alias ll='eza -l --group-directories-first --time-style=long-iso --git'
alias la='eza -a --group-directories-first'
alias tree='eza --tree'
{%- endif %}
alias find='fd'
alias cd='z'
alias cdi='zi'
alias diff='delta'
{%- if os() == "linux" %}

# WSL clipboard integration
alias pbcopy='clip.exe'
alias pbpaste='powershell.exe -command "Get-Clipboard"'
{%- endif %}

# grep
alias grep='grep --colour=always'
