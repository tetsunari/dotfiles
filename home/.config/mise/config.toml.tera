[settings]
# asdf プラグインは入れるたびに第三者のシェルスクリプトが走るので使わない
disable_backends = ["asdf"]

# minimum_release_age は未設定（mise 既定で全ツールが公開から 24h 待つ）。
# npm は作者のアカウントが奪われると乗っ取った版がすぐ出るため、npm のツールだけ 7 日待つ
[tools]
{% if os() == "macos" -%}
aws-cli = "latest"
gcloud = "latest"
go = "latest"
kubectl = "latest"
node = "latest"
"npm:@github/copilot" = { version = "latest", minimum_release_age = "7d" }

{% else -%}
aws-cli = "latest"
gcloud = "latest"

pnpm = "latest"

node = "latest"

bun = "latest"

go = "latest"

ecspresso = "latest"

kubectl = "latest"
kind = "latest"

helm = "latest"

kustomize = "latest"

hadolint = "latest"

eksctl = "latest"

gh = "latest"

uv = "latest"

# npm
"npm:@usebruno/cli" = { version = "latest", minimum_release_age = "7d" }
"npm:cdk-nag" = { version = "latest", minimum_release_age = "7d" }
"npm:agent-browser" = { version = "latest", minimum_release_age = "7d" }
"npm:wrangler" = { version = "latest", minimum_release_age = "7d" }

[tasks.brew-bundle]
description = "brewのインストール一覧を`Brewfile_wsl`に書き出す(vscodeの設定は無視)"
run = "cd && brew bundle dump --force --no-vscode --file Brewfile_wsl"

{% endif -%}
[tasks.cdk-out-clear]
description = "cdk.outの不要ファイルを削除"
run = 'npx cdk-agc'
